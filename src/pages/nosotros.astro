---
import "../styles/global.css";
import Header from "../components/Header.astro";
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta
      name="description"
      content="Conoce a Beacons IoT Technologies: soluciones RTLS, trazabilidad de activos y experiencias inteligentes con tecnología IoT."
    />
    <title>Nosotros | Beacons IoT Technologies</title>
  </head>

  <body
    class="m-0 bg-slate-50 text-slate-900 selection:bg-brand-500 selection:text-ink"
  >
    <Header />
    <About />
    <Footer />
  </body>
</html>
