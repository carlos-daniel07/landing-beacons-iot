---
import "../styles/global.css";
import Header from "../components/Header.astro";
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";
import SEOHead from "../components/SEOHead.astro";

const siteUrl = Astro.site ?? new URL("https://beaconsiottechnologies.com");
const pageUrl = new URL("/nosotros/", siteUrl).href;
const title = "Nosotros | Beacons IoT Technologies en Medellín, Colombia";
const description =
  "Conoce a Beacons IoT Technologies, empresa colombiana en Medellín que integra IoT, RTLS, Bluetooth Low Energy y trazabilidad de activos para organizaciones.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": `${pageUrl}#about`,
  url: pageUrl,
  name: title,
  description,
  inLanguage: "es-CO",
  about: { "@id": `${new URL("/", siteUrl).href}#organization` },
};
---

<!doctype html>
<html lang="es">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonicalPath="/nosotros/"
      structuredData={structuredData}
    />
  </head>

  <body
    class="m-0 bg-slate-50 text-slate-900 selection:bg-brand-500 selection:text-ink"
  >
    <Header />
    <About />
    <Footer />
  </body>
</html>
