---
import "../styles/global.css";
import Scene from "../components/Scene";
import BlueLink from "../components/BlueLink.astro";
import BeaconNav from "../components/BeaconNav.astro";
import Preloader from "../components/Preloader.astro";
import Hardware from "../components/Hardware.astro";
import Header from "../components/Header.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Beacons IoT Technologies</title>
  </head>

  <body
    class="m-0 p-0 bg-slate-50 text-slate-900 selection:bg-blue-500 selection:text-white"
  >
    <div class="fixed inset-0 z-0 pointer-events-none">
      <Scene client:load />
    </div>

    <Header />

    <main class="relative z-10 w-full">
      <section
        class="h-dvh w-full flex flex-col justify-center items-start px-8 sm:px-16 md:px-24 pointer-events-none"
      >
        <div class="max-w-4xl pointer-events-auto">
          <span
            class="text-blue-600 font-bold text-[10px] md:text-xs tracking-[0.2em] uppercase mb-5 block"
          >
            Tecnología IoT desde Medellín, Colombia
          </span>

          <h1
            class="text-5xl md:text-6xl lg:text-[5rem] font-medium text-[#0f172a] tracking-tight leading-[1.05] mb-8"
          >
            Soluciones IoT y <br />
            localización de <br />
            activos en <br />
            Colombia.
          </h1>

          <p
            class="text-lg md:text-xl text-slate-500 max-w-2xl leading-relaxed"
          >
            Creamos sistemas RTLS de localización en tiempo real, trazabilidad y
            automatización con tecnología Bluetooth Low Energy.
          </p>
        </div>
      </section>

      <BlueLink />
      <BeaconNav />
      <Hardware />
    </main>
  </body>
</html>
