---
import "../styles/global.css";
import Scene from "../components/Scene";
import BlueLink from "../components/BlueLink.astro";
import BeaconNav from "../components/BeaconNav.astro";
import Preloader from "../components/Preloader.astro";
import Hardware from "../components/Hardware.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProductModal from "../components/ProductModal.astro";
import SEOHead from "../components/SEOHead.astro";

const siteUrl = Astro.site ?? new URL("https://beaconsiottechnologies.com");
const homeUrl = new URL("/", siteUrl).href;
const organizationId = `${homeUrl}#organization`;
const homeTitle =
  "Soluciones IoT y RTLS en Medellín, Colombia | Beacons IoT";
const homeDescription =
  "Soluciones IoT en Medellín, Colombia: localización RTLS, trazabilidad de activos y automatización con tecnología BLE.";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "Beacons IoT Technologies",
      url: homeUrl,
      logo: new URL("/bit-rm.png", siteUrl).href,
      image: new URL("/social-card.png", siteUrl).href,
      description: homeDescription,
      email: "ventas@beaconsiottechnologies.com",
      telephone: "+57 314 614 8505",
      areaServed: [
        {
          "@type": "City",
          name: "Medellín",
          containedInPlace: { "@type": "Country", name: "Colombia" },
        },
        { "@type": "Country", name: "Colombia" },
      ],
      knowsAbout: [
        "Internet de las cosas (IoT)",
        "Localización en tiempo real (RTLS)",
        "Trazabilidad de activos",
        "Bluetooth Low Energy (BLE)",
        "Beacons y sensores IoT",
        "Automatización",
      ],
      sameAs: [
        "https://www.linkedin.com/company/beacons-iot-technologies",
        "https://www.facebook.com/people/Beacons-Iot-Technologies/61562747319948/",
        "https://www.instagram.com/beaconsiottechnologies/",
      ],
      contactPoint: {
        "@type": "ContactPoint",
        telephone: "+57 314 614 8505",
        email: "ventas@beaconsiottechnologies.com",
        contactType: "sales",
        areaServed: "CO",
        availableLanguage: ["Spanish"],
      },
    },
    {
      "@type": "WebSite",
      "@id": `${homeUrl}#website`,
      url: homeUrl,
      name: "Beacons IoT Technologies",
      inLanguage: "es-CO",
      publisher: { "@id": organizationId },
    },
    {
      "@type": "WebPage",
      "@id": `${homeUrl}#webpage`,
      url: homeUrl,
      name: homeTitle,
      description: homeDescription,
      inLanguage: "es-CO",
      isPartOf: { "@id": `${homeUrl}#website` },
      about: { "@id": organizationId },
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <SEOHead
      title={homeTitle}
      description={homeDescription}
      canonicalPath="/"
      structuredData={structuredData}
    />
    <script is:inline>
      try {
        // Esta marca solo dura una navegación; las visitas normales conservan el preloader.
        if (sessionStorage.getItem("skip-home-preloader") === "true") {
          sessionStorage.removeItem("skip-home-preloader");
          document.documentElement.classList.add("skip-home-preloader");
        }
      } catch (error) {
        console.error("No se pudo recuperar el estado del preloader.", error);
      }
    </script>
    <script is:inline>
      // Esperamos a que cargue el contenido para que el enlace aterrice en la sección correcta.
      const scrollToNavigationTarget = () => {
        const id = decodeURIComponent(window.location.hash.slice(1));
        const target = document.getElementById(id);
        if (!target) return;

        requestAnimationFrame(() => {
          const targetTop = target.getBoundingClientRect().top + window.scrollY;
          const headerOffset = window.innerWidth >= 768 ? 58 : 16;

          window.scrollTo({
            top: Math.max(0, targetTop - headerOffset),
            behavior: "smooth",
          });
        });
      };

      window.addEventListener("hashchange", scrollToNavigationTarget);
      window.addEventListener("pageshow", scrollToNavigationTarget);
      window.addEventListener("site:navigate", scrollToNavigationTarget);
    </script>
  </head>

  <body
    class="m-0 p-0 bg-slate-50 text-slate-900 selection:bg-brand-500 selection:text-ink"
  >
    <Preloader />
    <div class="fixed inset-0 z-0 pointer-events-none">
      <Scene client:load />
    </div>

    <Header />

    <main class="relative z-10 w-full">
      <section
        id="hero"
        class="min-h-dvh w-full flex items-center pt-24 pb-32 md:py-0 pointer-events-none"
      >
        <div class="mx-auto w-full max-w-7xl px-6 sm:px-10 lg:px-16">
          <div class="max-w-4xl pointer-events-auto">
            <span
              class="mb-5 block text-[11px] font-bold uppercase tracking-[0.2em] text-brand-700 md:text-xs"
            >
              Tecnología IoT desde Medellín, Colombia
            </span>

            <h1
              class="mb-6 text-4xl font-medium leading-[1.05] tracking-tight text-ink text-balance sm:text-5xl md:mb-8 lg:text-6xl xl:text-7xl 2xl:text-[5rem]"
            >
              Soluciones IoT y <br class="hidden lg:block" />
              localización de <br class="hidden lg:block" />
              activos en <br class="hidden lg:block" />
              Colombia.
            </h1>

            <p
              class="max-w-lg text-base leading-relaxed text-slate-500 sm:text-lg md:text-xl"
            >
              Creamos sistemas RTLS de localización en tiempo real, trazabilidad
              y automatización con tecnología Bluetooth Low Energy.
            </p>
          </div>
        </div>
      </section>

      <div id="blue-link">
        <BlueLink />
      </div>
      <div id="beacon-nav">
        <BeaconNav />
      </div>
      <div id="hardware">
        <Hardware />
      </div>
    </main>

    <Footer />
    <ProductModal />
  </body>
</html>
