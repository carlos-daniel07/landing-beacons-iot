---
const year = new Date().getFullYear();
---

<footer id="contacto" class="relative z-20 bg-white text-slate-900">
  <div
    class="mx-auto max-w-7xl px-6 pt-14 pb-32 sm:px-10 sm:pt-16 md:pb-16 lg:px-16 lg:pt-20 lg:pb-20"
  >
    <div
      class="flex flex-col justify-between gap-8 lg:flex-row lg:items-center"
    >
      <div>
        <span
          class="mb-3 block text-xs font-bold uppercase tracking-[0.16em] text-brand-800"
        >
          Sigamos conectados
        </span>
        <h2
          class="mb-3 text-3xl font-medium tracking-tight text-slate-900 sm:text-4xl"
        >
          Encuéntranos en redes
        </h2>
        <p class="text-base text-slate-500 sm:text-lg">
          Conoce nuestros proyectos, novedades y soluciones IoT.
        </p>
      </div>

      <nav
        aria-label="Redes sociales"
        class="grid grid-cols-2 gap-3 sm:grid-cols-4"
      >
        <a
          href="https://wa.me/573146148505"
          target="_blank"
          rel="noreferrer"
          class="group flex min-h-24 min-w-0 flex-col items-center justify-center gap-2 rounded-2xl border border-slate-200 px-5 py-4 text-slate-900 transition-colors hover:border-brand-400 hover:bg-brand-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            class="h-7 w-7"
          >
            <path
              d="M20.1 11.7a8.1 8.1 0 0 1-11.9 7.1L4 20l1.2-4a8.1 8.1 0 1 1 14.9-4.3Z"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M9 8.6c.2-.4.4-.4.7-.4h.4c.2 0 .3.1.4.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.2.2-.2.4 0 .6.4.7 1 1.3 1.7 1.7.2.1.4.1.6-.1l.6-.7c.2-.2.4-.2.6-.1l1.5.7c.2.1.3.2.3.4 0 .4-.2 1-.6 1.3-.4.4-1 .6-1.6.5-1-.1-2.3-.7-3.4-1.7-1.3-1.1-2.1-2.5-2.2-3.5-.1-.7.2-1.4.6-1.9Z"
              fill="currentColor"></path>
          </svg>
          <span
            class="text-xs font-medium text-slate-600 group-hover:text-brand-800"
            >WhatsApp</span
          >
        </a>

        <a
          href="https://www.linkedin.com/company/beacons-iot-technologies"
          target="_blank"
          rel="noreferrer"
          class="group flex min-h-24 min-w-0 flex-col items-center justify-center gap-2 rounded-2xl border border-slate-200 px-5 py-4 text-slate-900 transition-colors hover:border-brand-400 hover:bg-brand-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-7 w-7"
          >
            <path
              d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2ZM8.3 18H5.7V9.7h2.6V18ZM7 8.6a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3ZM18.3 18h-2.6v-4c0-1 0-2.2-1.4-2.2s-1.6 1.1-1.6 2.1V18h-2.6V9.7h2.5v1.1h.1c.4-.7 1.2-1.4 2.5-1.4 2.7 0 3.2 1.8 3.2 4.1V18Z"
            ></path>
          </svg>
          <span
            class="text-xs font-medium text-slate-600 group-hover:text-brand-800"
            >LinkedIn</span
          >
        </a>

        <a
          href="https://www.facebook.com/people/Beacons-Iot-Technologies/61562747319948/"
          target="_blank"
          rel="noreferrer"
          class="group flex min-h-24 min-w-0 flex-col items-center justify-center gap-2 rounded-2xl border border-slate-200 px-5 py-4 text-slate-900 transition-colors hover:border-brand-400 hover:bg-brand-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-7 w-7"
          >
            <path
              d="M12 2a10 10 0 1 0 1.7 19.9v-7h-2.4v-2.8h2.4V10c0-2.4 1.4-3.7 3.5-3.7 1 0 2 .2 2 .2v2.3H18c-1.2 0-1.6.7-1.6 1.5v1.8h2.7l-.4 2.8h-2.3v7A10 10 0 0 0 12 2Z"
            ></path>
          </svg>
          <span
            class="text-xs font-medium text-slate-600 group-hover:text-brand-800"
            >Facebook</span
          >
        </a>

        <a
          href="https://www.instagram.com/beaconsiottechnologies/"
          target="_blank"
          rel="noreferrer"
          class="group flex min-h-24 min-w-0 flex-col items-center justify-center gap-2 rounded-2xl border border-slate-200 px-5 py-4 text-slate-900 transition-colors hover:border-brand-400 hover:bg-brand-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            class="h-7 w-7"
          >
            <rect
              x="3.5"
              y="3.5"
              width="17"
              height="17"
              rx="4.5"
              stroke="currentColor"
              stroke-width="1.8"></rect>
            <circle
              cx="12"
              cy="12"
              r="4"
              stroke="currentColor"
              stroke-width="1.8"></circle>
            <circle cx="17.6" cy="6.7" r="1" fill="currentColor"></circle>
          </svg>
          <span
            class="text-xs font-medium text-slate-600 group-hover:text-brand-800"
            >Instagram</span
          >
        </a>
      </nav>
    </div>

    <section
      class="mt-16 flex flex-col gap-8 rounded-3xl bg-gradient-to-br from-brand-800 to-ink px-6 py-10 sm:px-12 sm:py-14 lg:mt-24 lg:flex-row lg:items-center lg:justify-between lg:gap-10"
    >
      <div>
        <span
          class="mb-4 block text-xs font-bold uppercase tracking-[0.16em] text-brand-300"
        >
          Asesoría personalizada
        </span>
        <h2
          class="mb-3 text-3xl font-medium leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl"
        >
          ¿Tienes un proyecto en mente?
        </h2>
        <p class="text-sm text-brand-100 sm:text-base">
          Escríbenos y te ayudamos a elegir la tecnología adecuada.
        </p>
      </div>
      <a
        href="https://wa.me/573146148505"
        target="_blank"
        rel="noreferrer"
        class="bg-brand-500 text-ink hover:bg-brand-400 transition-colors inline-flex min-h-14 shrink-0 items-center justify-center px-6 py-4 text-sm font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-brand-800 rounded-full"
      >
        WhatsApp · 314 614 8505
      </a>
    </section>

    <div
      class="mt-12 flex flex-col gap-3 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} Beacons IoT Technologies</p>
      <p>
        Medellín, Colombia · <a
          class="transition-colors hover:text-brand-800"
          href="mailto:ventas@beaconsiottechnologies.com"
          >ventas@beaconsiottechnologies.com</a
        >
      </p>
    </div>
  </div>
</footer>
