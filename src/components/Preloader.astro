<script>
  import gsap from "gsap";

  window.addEventListener("DOMContentLoaded", () => {
    const paths = document.querySelectorAll(
      ".bit-path",
    ) as NodeListOf<SVGPathElement>;
    const preloader = document.getElementById("bit-preloader");
    const svgLogo = document.getElementById("bit-logo-svg");

    if (!paths.length || !preloader || !svgLogo) return;

    paths.forEach((path) => {
      const length = path.getTotalLength();
      path.style.strokeDasharray = `${length}`;
      path.style.strokeDashoffset = `${length}`;
    });

    const tl = gsap.timeline();

    // 1. Trazado láser exacto del logo
    tl.to(
      paths,
      {
        strokeDashoffset: 0,
        duration: 2.5,
        ease: "power2.inOut",
      },
      "start",
    );

    // 2. Relleno con colores originales
    tl.to(
      paths,
      {
        fill: (i, el) => el.getAttribute("data-fill"),
        strokeWidth: 0,
        duration: 0.8,
        ease: "power2.out",
      },
      "-=0.5",
    );

    // 3. Zoom y transición de salida
    tl.to(
      svgLogo,
      {
        scale: 3,
        opacity: 0,
        duration: 0.6,
        ease: "power3.in",
      },
      "+=0.3",
    ).to(
      preloader,
      {
        opacity: 0,
        duration: 0.5,
        ease: "power2.inOut",
        onComplete: () => {
          preloader.remove();
        },
      },
      "-=0.4",
    );
  });
</script>
