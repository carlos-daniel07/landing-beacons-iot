---
import Filters from "./Filters.astro";
import ProductCard from "./ProductCard.astro";
import { productos } from "../lib/products";
---

<section
  id="catalogo-section"
  class="relative z-20 w-full bg-[#f8fafc] py-16 md:py-24"
>
  <div class="mx-auto w-full max-w-7xl px-6 sm:px-10 lg:px-16">
    <div id="hardware-navigation-target" class="mb-10 max-w-3xl">
      <span
        class="mb-3 block text-xs font-bold uppercase tracking-widest text-brand-700"
        >CATÁLOGO BIT</span
      >
      <h2
        class="mb-4 text-3xl font-medium tracking-tight text-ink text-balance sm:text-5xl lg:text-6xl"
      >
        Beacons, sensores y gateways IoT
      </h2>
      <p class="text-base text-slate-500 sm:text-lg">
        Explora beacons BLE, sensores, gateways IoT y dispositivos KKM para
        localización y monitoreo. Solicita asesoría con BIT en Colombia.
      </p>
    </div>

    <Filters />

    <div class="mb-6">
      <span id="results-count" class="text-sm font-medium text-slate-500">
        {productos.length} dispositivos encontrados
      </span>
    </div>

    <div
      class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8 xl:grid-cols-4"
      id="products-grid"
      data-site-url={Astro.site?.origin}
    >
      {productos.map((producto) => <ProductCard producto={producto} />)}
    </div>

    <div class="mt-12 flex justify-center">
      <button
        id="show-more-products"
        type="button"
        class="hidden cursor-pointer rounded-full border border-slate-300 px-8 py-3 text-sm font-semibold text-slate-700 transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-700 hover:bg-brand-700 hover:text-white hover:shadow-md active:translate-y-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2"
      >
        Mostrar más
      </button>
    </div>
  </div>
</section>

<script>
  import {
    getProductHash,
    type Producto,
  } from "../lib/products";

  document.addEventListener("DOMContentLoaded", () => {
    const cards = document.querySelectorAll(
      ".product-card",
    ) as NodeListOf<HTMLElement>;
    const searchInput = document.getElementById(
      "search-input",
    ) as HTMLInputElement;
    const categorySelect = document.getElementById(
      "category-select",
    ) as HTMLSelectElement;
    const filterBtns = document.querySelectorAll(".filter-btn");
    const resultsCount = document.getElementById("results-count");
    const showMoreButton = document.getElementById("show-more-products");
    const pageSize = 4;
    let visibleLimit = pageSize;

    // Aplicamos filtros y límite en la misma pasada para que "Mostrar más" respete la búsqueda.
    const applyFilters = () => {
      const searchTerm = searchInput.value.toLowerCase();
      const selectTerm = categorySelect.value;
      const activeBtn =
        document
          .querySelector(".filter-btn.bg-brand-50")
          ?.getAttribute("data-filter") || "Todos";

      const matchingCards: HTMLElement[] = [];

      cards.forEach((card) => {
        const rawData = card.getAttribute("data-producto");
        if (!rawData) return;
        const data = JSON.parse(rawData) as Producto;

        const matchSearch =
          data.nombre.toLowerCase().includes(searchTerm) ||
          data.referencia.toLowerCase().includes(searchTerm);
        const matchSelect = selectTerm === "Todos" || data.tipo === selectTerm;
        const matchBtn = activeBtn === "Todos" || data.tipo === activeBtn;

        if (matchSearch && matchSelect && matchBtn) {
          matchingCards.push(card);
        } else {
          card.style.display = "none";
        }
      });

      matchingCards.forEach((card, index) => {
        card.style.display = index < visibleLimit ? "flex" : "none";
      });

      if (resultsCount) {
        const count = matchingCards.length;
        resultsCount.innerText = `${count} dispositivo${count !== 1 ? "s" : ""} encontrado${count !== 1 ? "s" : ""}`;
      }

      showMoreButton?.classList.toggle(
        "hidden",
        matchingCards.length <= visibleLimit,
      );
    };

    const resetAndApplyFilters = () => {
      visibleLimit = pageSize;
      applyFilters();
    };

    searchInput?.addEventListener("input", resetAndApplyFilters);
    categorySelect?.addEventListener("change", resetAndApplyFilters);
    showMoreButton?.addEventListener("click", () => {
      visibleLimit += pageSize;
      applyFilters();
    });

    applyFilters();

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const filterVal = target.getAttribute("data-filter") || "Todos";

        filterBtns.forEach((b) => {
          b.classList.remove(
            "border-brand-700",
            "text-brand-700",
            "bg-brand-50",
            "font-bold",
          );
          b.classList.add("border-slate-200", "text-slate-600", "font-medium");
        });

        target.classList.remove(
          "border-slate-200",
          "text-slate-600",
          "font-medium",
        );
        target.classList.add(
          "border-brand-700",
          "text-brand-700",
          "bg-brand-50",
          "font-bold",
        );

        if (categorySelect) categorySelect.value = filterVal;
        resetAndApplyFilters();
      });
    });

    // El mapa por URL permite abrir el producto desde un enlace compartido.
    const modal = document.getElementById("simple-modal");
    const backdrop = document.getElementById("modal-backdrop");
    const contentBox = document.getElementById("modal-content-box");
    const btnClose = document.getElementById("close-modal-btn");
    const whatsappLink = document.getElementById(
      "m-whatsapp-link",
    ) as HTMLAnchorElement | null;
    const copyLinkButton = document.getElementById(
      "m-copy-link-btn",
    ) as HTMLButtonElement | null;
    const copyStatus = document.getElementById("m-copy-status");

    const mImg = document.getElementById("m-img") as HTMLImageElement;
    const mBadge = document.getElementById("m-badge");
    const mTitle = document.getElementById("m-title");
    const mRef = document.getElementById("m-ref");
    const mRange = document.getElementById("m-range");
    const mBattery = document.getElementById("m-battery");
    const mDim = document.getElementById("m-dim");
    const mFeatures = document.getElementById("m-features");

    const mRelatedSection = document.getElementById("m-related-section");
    const mRelatedGrid = document.getElementById("m-related-grid");

    const productsByUrl = new Map<string, Producto>();
    cards.forEach((card) => {
      const rawData = card.getAttribute("data-producto");
      const productUrl = card.dataset.productUrl;
      if (rawData && productUrl) {
        productsByUrl.set(productUrl, JSON.parse(rawData) as Producto);
      }
    });

    const getProductUrl = (p: Producto) => {
      return new URL(getProductHash(p.slug), window.location.origin);
    };

    const populateModal = (p: Producto) => {
      if (mImg) mImg.src = p.url_imagen;
      if (mImg) mImg.alt = p.nombre;
      if (mBadge)
        mBadge.innerText =
          p.tipo === "Beacon Bluetooth"
            ? "Baliza Bluetooth"
            : p.tipo || "Hardware IoT";
      if (mTitle) mTitle.innerText = p.nombre;
      if (mRef) mRef.innerText = `FABRICANTE: KKM · REFERENCIA ${p.referencia}`;
      if (mRange) mRange.innerText = p.alcance || "N/A";
      if (mBattery) mBattery.innerText = p.bateria || "N/A";
      if (mDim) mDim.innerText = p.dimensiones || "N/A";

      if (mFeatures) {
        mFeatures.replaceChildren();
        p.capacidades.forEach((cap) => {
          const item = document.createElement("li");
          item.className = "flex items-start gap-2";
          const marker = document.createElement("div");
          marker.className =
            "w-1.5 h-1.5 bg-brand-500 rounded-full flex-shrink-0 mt-1.5";
          const text = document.createElement("span");
          text.textContent = cap;
          item.append(marker, text);
          mFeatures.appendChild(item);
        });
      }

      if (whatsappLink) {
        const productUrl = getProductUrl(p).href;
        const message = `Hola, quisiera recibir información sobre ${p.nombre} (referencia ${p.referencia}). Lo vi aquí: ${productUrl}`;
        whatsappLink.href = `https://wa.me/573146148505?text=${encodeURIComponent(message)}`;
      }
      if (copyStatus) copyStatus.textContent = "";

      if (mRelatedGrid && mRelatedSection) {
        mRelatedGrid.replaceChildren();
        let relatedCount = 0;

        productsByUrl.forEach((otherP) => {
          if (
            otherP.tipo === p.tipo &&
            otherP.slug !== p.slug &&
            relatedCount < 3
          ) {
            relatedCount++;

            const relCard = document.createElement("div");
            relCard.className =
              "bg-white border border-slate-200 rounded-lg p-5 cursor-pointer over:border-brand-500 hover:shadow-md transition-all flex flex-col justify-center min-h-[85px]";
            const title = document.createElement("h4");
            title.className = "text-[13px] font-medium text-ink mb-1 leading-tight";
            title.textContent = otherP.nombre;
            const reference = document.createElement("span");
            reference.className = "text-[11px] text-slate-500 font-mono";
            reference.textContent = `KKM · ${otherP.referencia}`;
            relCard.append(title, reference);

            relCard.addEventListener("click", () => {
              openProduct(otherP, true);
              if (contentBox) contentBox.scrollTop = 0;
            });

            mRelatedGrid.appendChild(relCard);
          }
        });

        mRelatedSection.style.display = relatedCount > 0 ? "block" : "none";
      }
    };

    const showModal = () => {
      if (!modal) return;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      setTimeout(() => {
        backdrop?.classList.remove("opacity-0");
        contentBox?.classList.remove("opacity-0", "scale-95");
        contentBox?.classList.add("opacity-100", "scale-100");
      }, 10);
    };

    const openProduct = (p: Producto, updateUrl = false) => {
      populateModal(p);
      showModal();

      if (updateUrl) {
        const url = getProductUrl(p);
        if (window.location.hash !== url.hash) {
          const state = { productModal: true };
          if (history.state?.productModal) {
            history.replaceState(state, "", url);
          } else {
            history.pushState(state, "", url);
          }
        }
      }
    };

    const hideModal = () => {
      if (backdrop) backdrop.classList.add("opacity-0");
      if (contentBox) {
        contentBox.classList.remove("opacity-100", "scale-100");
        contentBox.classList.add("opacity-0", "scale-95");
      }
      setTimeout(() => {
        if (modal) {
          modal.classList.add("hidden");
          modal.classList.remove("flex");
        }
      }, 300);
    };

    const closeModal = () => {
      if (history.state?.productModal) {
        history.back();
        return;
      }

      if (window.location.hash.startsWith("#producto-")) {
        const url = new URL(window.location.href);
        url.hash = "";
        history.replaceState(history.state, "", url);
      }
      hideModal();
    };

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        const product = productsByUrl.get(card.dataset.productUrl ?? "");
        if (product) openProduct(product, true);
      });
    });

    if (btnClose) btnClose.addEventListener("click", closeModal);
    if (backdrop) backdrop.addEventListener("click", closeModal);
    window.addEventListener("popstate", () => {
      const product = productsByUrl.get(window.location.hash);
      if (product) {
        openProduct(product);
      } else {
        hideModal();
      }
    });

    copyLinkButton?.addEventListener("click", async () => {
      const product = productsByUrl.get(window.location.hash);
      if (!product || !copyStatus) return;

      try {
        await navigator.clipboard.writeText(getProductUrl(product).href);
        copyStatus.textContent = "Enlace del producto copiado.";
      } catch {
        copyStatus.textContent =
          "No se pudo copiar el enlace. Copia la URL desde la barra del navegador.";
      }
    });

    const initialProduct = productsByUrl.get(window.location.hash);
    if (initialProduct) openProduct(initialProduct);
  });
</script>
