---
---

<div class="mb-8 w-full border-b border-slate-200 pb-8">
  <div
    id="filter-buttons"
    class="-mx-6 mb-6 flex gap-2 overflow-x-auto px-6 pb-1 [scrollbar-width:none] sm:-mx-10 sm:px-10 md:mx-0 md:flex-wrap md:overflow-visible md:px-0 [&::-webkit-scrollbar]:hidden"
  >
    <button
      class="filter-btn shrink-0 whitespace-nowrap rounded-full border px-4 py-2 text-sm font-bold transition-colors border-brand-700 text-brand-700 bg-brand-50"
      data-filter="Todos">Todos</button
    >
    <button
      class="filter-btn shrink-0 whitespace-nowrap rounded-full border px-4 py-2 text-sm font-medium transition-colors border-slate-200 text-slate-600 hover:bg-slate-100"
      data-filter="Beacon Bluetooth">Beacons Bluetooth BLE</button
    >
    <button
      class="filter-btn shrink-0 whitespace-nowrap rounded-full border px-4 py-2 text-sm font-medium transition-colors border-slate-200 text-slate-600 hover:bg-slate-100"
      data-filter="Gateway IoT">Gateways BLE e IoT</button
    >
    <button
      class="filter-btn shrink-0 whitespace-nowrap rounded-full border px-4 py-2 text-sm font-medium transition-colors border-slate-200 text-slate-600 hover:bg-slate-100"
      data-filter="Beacon LTE">Beacons LTE</button
    >
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:max-w-2xl md:gap-6">
    <div class="flex flex-col gap-2">
      <label
        for="search-input"
        class="text-[10px] font-bold uppercase tracking-widest text-slate-500"
        >Buscar</label
      >
      <input
        type="text"
        id="search-input"
        placeholder="Nombre o referencia"
        class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-base text-slate-700 transition-colors focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 md:text-sm"
      />
    </div>

    <div class="flex flex-col gap-2">
      <label
        for="category-select"
        class="text-[10px] font-bold uppercase tracking-widest text-slate-500"
        >Categoría</label
      >
      <select
        id="category-select"
        class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-base text-slate-700 transition-colors focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 md:text-sm"
      >
        <option value="Todos">Todos</option>
        <option value="Beacon Bluetooth">Beacons Bluetooth BLE</option>
        <option value="Gateway IoT">Gateways BLE e IoT</option>
        <option value="Beacon LTE">Beacons LTE</option>
      </select>
    </div>
  </div>
</div>
