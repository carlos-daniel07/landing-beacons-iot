---
// src/components/Filtros.astro
---

<div class="w-full relative z-10 mb-8 border-b border-slate-200 pb-8">
  <div class="flex flex-wrap gap-3 mb-8" id="filter-buttons">
    <button
      class="filter-btn px-4 py-2 border rounded-md text-sm font-bold transition-colors border-blue-600 text-blue-600 bg-blue-50"
      data-filter="Todos">Todos</button
    >
    <button
      class="filter-btn px-4 py-2 border rounded-md text-sm font-medium transition-colors border-slate-200 text-slate-600 hover:bg-slate-100"
      data-filter="Beacon Bluetooth">Beacons Bluetooth BLE</button
    >
    <button
      class="filter-btn px-4 py-2 border rounded-md text-sm font-medium transition-colors border-slate-200 text-slate-600 hover:bg-slate-100"
      data-filter="Gateway IoT">Gateways BLE e IoT</button
    >
    <button
      class="filter-btn px-4 py-2 border rounded-md text-sm font-medium transition-colors border-slate-200 text-slate-600 hover:bg-slate-100"
      data-filter="Beacon LTE">Beacons LTE</button
    >
  </div>

  <div class="flex flex-col md:flex-row gap-6">
    <div class="flex flex-col gap-2 w-full md:w-1/3">
      <label
        class="text-[10px] font-bold text-slate-500 uppercase tracking-widest"
        >BUSCAR</label
      >
      <input
        type="text"
        id="search-input"
        placeholder="Nombre o referencia"
        class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors text-sm text-slate-700 bg-white"
      />
    </div>

    <div class="flex flex-col gap-2 w-full md:w-1/3">
      <label
        class="text-[10px] font-bold text-slate-500 uppercase tracking-widest"
        >CATEGORÍA</label
      >
      <select
        id="category-select"
        class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors text-sm text-slate-700 bg-white"
      >
        <option value="Todos">Todos</option>
        <option value="Beacon Bluetooth">Beacons Bluetooth BLE</option>
        <option value="Gateway IoT">Gateways BLE e IoT</option>
        <option value="Beacon LTE">Beacons LTE</option>
      </select>
    </div>
  </div>
</div>
