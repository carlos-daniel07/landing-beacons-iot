---
import { getProductHash, type Producto } from "../lib/products";

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
---

<div
  class="product-card group cursor-pointer w-full h-100 bg-white border border-slate-200 rounded-2xl overflow-hidden flex flex-col shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 relative"
  data-producto={JSON.stringify(producto)}
  data-product-url={getProductHash(producto.slug)}
>
  <div class="absolute left-5 top-5 z-10">
    <span
      class="bg-ink text-white text-[10px] font-bold uppercase tracking-wider px-3 py-1.5 rounded-md"
    >
      {
        producto.tipo === "Beacon Bluetooth"
          ? "Baliza Bluetooth"
          : producto.tipo || "Hardware IoT"
      }
    </span>
  </div>

  <div
    class="flex-1 w-full bg-slate-50/50 flex items-center justify-center p-8 overflow-hidden"
  >
    <img
      src={producto.url_imagen}
      alt={producto.nombre}
      class="w-full h-full object-contain drop-shadow-sm group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
    />
  </div>

  <div
    class="h-35 w-full p-5 border-t border-slate-100 flex flex-col justify-start bg-white"
  >
    <span
      class="text-slate-500 text-[10px] font-mono font-bold mb-1.5 uppercase tracking-wide"
      >KKM · REF. {producto.referencia}</span
    >

    <h3
      class="text-lg font-bold text-ink leading-tight line-clamp-2 h-[3.2rem] group-hover:text-brand-700 transition-colors"
    >
      {producto.nombre}
    </h3>

    <div
      class="mt-auto flex justify-between items-center text-sm font-semibold text-slate-500 group-hover:text-brand-700 transition-colors"
    >
      <span>Ver especificaciones</span>
      <svg
        class="w-4 h-4 transform group-hover:translate-x-1 transition-transform"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
      >
    </div>
  </div>
</div>
