---
const sectionLink = (id: string) =>
  Astro.url.pathname === "/" ? `#${id}` : `/#${id}`;
---

<header
  id="main-header"
  class="fixed z-50 pointer-events-none transition-all duration-500 ease-out
  bottom-[max(1.25rem,env(safe-area-inset-bottom))] inset-x-5 max-w-sm mx-auto
  md:top-6 md:bottom-auto md:inset-x-0 md:max-w-5xl md:w-[95%]"
>
  <div
    id="header-container"
    class="pointer-events-auto flex justify-between items-center transition-all duration-500 ease-out
    bg-white/95 border border-slate-200/80 shadow-2xl
    rounded-[4xl] px-5 py-3
    md:bg-transparent md:border-transparent md:shadow-none md:px-0"
  >
    <a
      href="/"
      aria-label="Beacons IoT Technologies, inicio"
      class="hidden md:flex items-center gap-2 transition-transform hover:scale-105 pl-4"
    >
      <img
        id="header-logo"
        src="/Logo.png"
        alt="BiT Logo"
        class="h-8 w-auto drop-shadow-sm transition-all duration-500"
      />
    </a>

    <nav
      id="desktop-nav"
      class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-700 transition-all duration-500 ease-out
      bg-white/95 px-8 py-2.5 rounded-full border border-slate-200/80 shadow-sm"
    >
      <a
        href={sectionLink("solutions-navigation-target")}
        class="hover:text-brand-700 transition-colors">Soluciones</a
      >
      <a href={sectionLink("hardware-navigation-target")} class="hover:text-brand-700 transition-colors"
        >Hardware</a
      >
      <a href="/nosotros/" class="hover:text-brand-700 transition-colors"
        >Nosotros</a
      >
      <a href={sectionLink("contact-navigation-target")} class="hover:text-brand-700 transition-colors"
        >Contacto</a
      >
    </nav>

    <div class="hidden md:block pr-4">
      <a
        id="header-btn"
        href={sectionLink("contact-navigation-target")}
        class="inline-block bg-ink hover:bg-brand-700 text-white text-xs font-bold uppercase tracking-wider px-6 py-2.5 rounded-full transition-all duration-500 shadow-md hover:shadow-lg hover:-translate-y-0.5"
      >
        Cotizar Kit
      </a>
    </div>

    <nav
      class="flex md:hidden w-full justify-between items-center text-[9px] font-bold text-slate-500 uppercase tracking-wide px-1"
    >
      <a
        href={sectionLink("solutions-navigation-target")}
        class="flex flex-col items-center gap-1.5 hover:text-brand-700 transition-colors"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
          ></path></svg
        >
        <span>Solución</span>
      </a>

      <a
        href={sectionLink("hardware-navigation-target")}
        class="flex flex-col items-center gap-1.5 hover:text-brand-700 transition-colors"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z"
          ></path></svg
        >
        <span>Hardware</span>
      </a>

      <a
        href="/nosotros/"
        class="flex flex-col items-center gap-1.5 hover:text-brand-700 transition-colors"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M16 18a4 4 0 0 0-8 0m12 3H4v-1a8 8 0 0 1 16 0v1ZM12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"
          ></path></svg
        >
        <span>Nosotros</span>
      </a>

      <a
        href={sectionLink("contact-navigation-target")}
        class="flex flex-col items-center gap-1.5 hover:text-brand-700 transition-colors"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
          ></path></svg
        >
        <span>Contacto</span>
      </a>

      <a
        href={sectionLink("contact-navigation-target")}
        class="flex flex-col items-center gap-1.5 text-brand-700"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
        >
        <span>Cotizar</span>
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  // En el inicio hacemos el salto nosotros; desde otra página dejamos que cargue el hash normal.
  document.addEventListener(
    "click",
    (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest("a[href]");
      if (!(link instanceof HTMLAnchorElement)) return;
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        (link.target && link.target !== "_self")
      ) {
        return;
      }

      const destination = new URL(link.href, window.location.href);
      if (
        destination.origin === window.location.origin &&
        destination.pathname === "/" &&
        window.location.pathname === "/" &&
        destination.hash
      ) {
        event.preventDefault();
        if (destination.hash !== window.location.hash) {
          window.history.pushState(null, "", destination);
        }
        window.dispatchEvent(new Event("site:navigate"));
        return;
      }

      if (
        destination.origin !== window.location.origin ||
        destination.pathname !== "/" ||
        window.location.pathname === "/"
      ) {
        return;
      }

      try {
        window.sessionStorage.setItem("skip-home-preloader", "true");
      } catch (error) {
        console.error("No se pudo omitir el preloader al volver al inicio.", error);
      }
    },
    true,
  );
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const mainHeader = document.getElementById("main-header");
    const headerContainer = document.getElementById("header-container");
    const desktopNav = document.getElementById("desktop-nav");
    const headerLogo = document.getElementById("header-logo");
    const headerBtn = document.getElementById("header-btn");

    // Pilas: actualizamos el aspecto solo cuando el header cruza el umbral de scroll.
    let scrolled = false;

    const onScroll = () => {
      if (window.innerWidth < 768) return;

      const shouldBeScrolled = window.scrollY > 40;
      if (shouldBeScrolled === scrolled) return; // nada cambió, no hacemos nada
      scrolled = shouldBeScrolled;

      if (scrolled) {
        mainHeader?.classList.remove("md:top-6");
        mainHeader?.classList.add("md:top-[5px]");

        headerContainer?.classList.remove(
          "md:bg-transparent",
          "md:border-transparent",
          "md:shadow-none",
          "md:px-0",
        );
        headerContainer?.classList.add(
          "md:bg-white/95",
          "md:border-slate-200/80",
          "md:shadow-md",
          "md:px-2",
          "md:py-1.5",
          "md:rounded-full",
        );

        desktopNav?.classList.remove(
          "bg-white/95",
          "border-slate-200/80",
          "shadow-sm",
          "py-2.5",
        );
        desktopNav?.classList.add(
          "bg-transparent",
          "border-transparent",
          "shadow-none",
          "py-1",
        );

        headerLogo?.classList.remove("h-8");
        headerLogo?.classList.add("h-6");

        headerBtn?.classList.remove("py-2.5", "px-6");
        headerBtn?.classList.add("py-2", "px-5", "text-[10px]");
      } else {
        mainHeader?.classList.add("md:top-6");
        mainHeader?.classList.remove("md:top-[5px]");

        headerContainer?.classList.add(
          "md:bg-transparent",
          "md:border-transparent",
          "md:shadow-none",
          "md:px-0",
        );
        headerContainer?.classList.remove(
          "md:bg-white/95",
          "md:border-slate-200/80",
          "md:shadow-md",
          "md:px-2",
          "md:py-1.5",
          "md:rounded-full",
        );

        desktopNav?.classList.add(
          "bg-white/95",
          "border-slate-200/80",
          "shadow-sm",
          "py-2.5",
        );
        desktopNav?.classList.remove(
          "bg-transparent",
          "border-transparent",
          "shadow-none",
          "py-1",
        );

        headerLogo?.classList.add("h-8");
        headerLogo?.classList.remove("h-6");

        headerBtn?.classList.add("py-2.5", "px-6");
        headerBtn?.classList.remove("py-2", "px-5", "text-[10px]");
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll(); // por si recargas la página estando ya más abajo
  });
</script>
