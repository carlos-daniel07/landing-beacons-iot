---
// src/components/BeaconNav.astro
---

<section
  id="beaconnav-section"
  class="relative z-20 flex min-h-dvh w-full items-center bg-transparent py-16 lg:py-24"
>
  <div
    class="mx-auto flex w-full max-w-7xl flex-col items-start gap-10 px-6 sm:px-10 lg:flex-row lg:items-center lg:justify-between lg:gap-16 lg:px-16"
  >
    <!-- Lado Izquierdo: Textos -->
    <div class="pointer-events-auto z-20 w-full max-w-md">
      <span
        class="text-brand-700 font-mono text-[10px] md:text-xs tracking-[0.2em] uppercase mb-4 block"
        >Marketing Inteligente</span
      >
      <h2
        class="mb-4 text-3xl font-medium leading-tight tracking-tight text-ink text-balance sm:text-4xl lg:mb-6 lg:text-5xl"
      >
        BeaconNAV
      </h2>
      <p class="text-base leading-relaxed text-slate-500 lg:text-lg">
        Navegación precisa en interiores y experiencias inteligentes basadas en
        proximidad. BeaconNAV es una aplicación móvil desarrollada por Beacons
        IoT Technologies para ayudar a los usuarios a ubicarse con precisión en
        edificios, bodegas, centros comerciales, hospitales y aeropuertos.
        Utiliza balizas BLE en espacios donde la señal GPS no funciona
        correctamente. La aplicación también permite enviar notificaciones
        contextuales basadas en proximidad para mejorar la interacción con los
        usuarios.
      </p>
    </div>

    <!-- Lado Derecho: Interfaz del Smartphone (Light Theme) -->
    <div
      class="relative h-150 w-[min(300px,100%)] self-center lg:self-auto border-8 border-slate-100 rounded-[3rem] bg-white shadow-[0_20px_50px_rgba(15,23,42,0.1)] flex flex-col items-center justify-start overflow-hidden shrink-0"
    >
      <!-- El Notch (Cámara superior del celular) -->
      <div
        class="w-28 h-7 bg-slate-100 rounded-b-3xl absolute top-0 z-30 border-b border-x border-slate-200"
      >
      </div>

      <!-- Contenido de la Pantalla del Celular -->
      <div class="absolute inset-0 p-5 pt-16 flex flex-col gap-3">
        <!-- Barra superior de búsqueda/usuario -->
        <div class="w-full flex justify-between items-center px-1 mb-2">
          <div
            class="w-32 h-6 bg-slate-50 rounded-full border border-slate-200 flex items-center px-3"
          >
            <div class="w-2 h-2 rounded-full bg-slate-300"></div>
          </div>
          <div
            class="w-8 h-8 rounded-full bg-slate-50 border border-slate-200 shadow-sm"
          >
          </div>
        </div>

        <!-- Locales Superiores -->
        <div class="flex gap-3 h-24">
          <div
            class="flex-[1.5] bg-slate-50/80 rounded-2xl border border-slate-200 flex items-center justify-center shadow-sm"
          >
            <span
              class="text-[8px] text-slate-400 uppercase font-bold tracking-wider"
              >Local 1</span
            >
          </div>
          <div
            class="flex-1 bg-slate-50/80 rounded-2xl border border-slate-200 shadow-sm"
          >
          </div>
        </div>

        <!-- Pasillo (Separador) -->
        <div class="w-full h-8 flex items-center justify-center my-1 relative">
          <div class="w-full h-0.5 border-t-2 border-dashed border-slate-300">
          </div>
          <span
            class="absolute text-[9px] bg-white px-3 text-slate-400 tracking-widest uppercase font-bold"
            >Pasillo Principal</span
          >
        </div>

        <!-- Locales Inferiores y Zona de Radar -->
        <div class="flex gap-3 h-36">
          <div
            class="flex-1 bg-slate-50/80 rounded-2xl border border-slate-200 shadow-sm"
          >
          </div>

          <div
            class="flex-[1.2] bg-brand-50 rounded-2xl border border-brand-200 relative flex items-center justify-center shadow-inner"
          >
            <div
              id="proximity-radar"
              class="absolute inset-0 flex items-center justify-center opacity-0 scale-50 z-10"
            >
              <!-- Anillos del Radar -->
              <div
                class="w-28 h-28 border-[1.5px] border-brand-500/40 rounded-full animate-ping absolute"
              >
              </div>
              <div
                class="w-16 h-16 border-[1.5px] border-brand-500/60 rounded-full animate-ping absolute"
                style="animation-delay: 0.2s;"
              >
              </div>
              <!-- Punto central del Beacon -->
              <div
                class="w-6 h-6 rounded-full flex items-center justify-center bg-brand-500 hadow-[0_0_15px_rgba(0,190,253,0.45)]"
              >
                <div class="w-2 h-2 bg-white rounded-full"></div>
              </div>
            </div>
            <span
              class="absolute bottom-2 right-2 text-[8px] font-bold text-brand-700 uppercase tracking-widest"
              >Tu Tienda</span
            >
          </div>
        </div>

        <!-- Entrada Sur -->
        <div
          class="w-full flex-1 bg-slate-50/80 rounded-t-3xl border border-slate-200 mt-3 flex items-start justify-center pt-4 shadow-sm"
        >
          <span
            class="text-[8px] text-slate-400 uppercase font-bold tracking-wider"
            >Entrada Sur</span
          >
        </div>
      </div>

      <!-- NOTIFICACIÓN PUSH TIPO APPLE -->
      <div
        id="push-notification"
        class="w-[90%] bg-white/95 border border-slate-100 p-4 rounded-2xl absolute top-12 translate-y-[-200%] z-20 flex items-center space-x-4 shadow-[0_15px_40px_rgba(15,23,42,0.12)]"
      >
        <div
          class="w-10 h-10 bg-linear-to-tr from-brand-700 to-brand-900 rounded-xl shrink-0 flex items-center justify-center text-white font-bold text-[11px] shadow-md"
        >
          BiT
        </div>
        <div>
          <h4 class="text-slate-800 font-bold text-[13px] leading-tight">
            ¡Bienvenido a la Tienda!
          </h4>
          <p class="text-slate-500 text-[11px] mt-1 leading-tight">
            Tienes un 20% de descuento en periféricos hoy. Toca para ver.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const tlBeacon = gsap.timeline({
      scrollTrigger: {
        trigger: "#beaconnav-section",
        start: "top center",
        toggleActions: "play none none reverse",
      },
    });

    tlBeacon
      .to("#proximity-radar", { opacity: 1, scale: 1, duration: 0.8 })
      .to("#push-notification", {
        y: 0,
        duration: 1.2,
        ease: "back.out(1.7)",
      });
  });
</script>
